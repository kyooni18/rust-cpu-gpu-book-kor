---
import { Code } from '@astrojs/starlight/components';

interface Props {
  /** 실행할 Rust 코드입니다. `?raw` import로 전달합니다 */
  code: string;
  /** Rust 릴리스 채널 */
  channel?: 'stable' | 'beta' | 'nightly';
  /** 빌드 모드 */
  mode?: 'debug' | 'release';
  /** 에디션 */
  edition?: '2015' | '2018' | '2021' | '2024';
  /** 코드 블록에 표시할 제목 */
  title?: string;
}

const {
  code,
  channel = 'stable',
  mode = 'debug',
  edition = '2024',
  title,
} = Astro.props;

const src = code.replace(/\n+$/, '\n');
const playgroundUrl = `https://play.rust-lang.org/?version=${channel}&mode=${mode}&edition=${edition}&code=${encodeURIComponent(src)}`;
---

<div
  class="rust-play"
  data-channel={channel}
  data-mode={mode}
  data-edition={edition}
>
  <div class="rust-play__code"><Code code={src} lang="rust" title={title} /></div>
  <textarea class="rust-play__editor" spellcheck="false">{src}</textarea>
  <div class="rust-play__toolbar">
    <button class="rust-play__btn rust-play__btn--run" type="button">
      ▶ 실행
    </button>
    <button class="rust-play__btn rust-play__btn--edit" type="button">
      편집
    </button>
    <button class="rust-play__btn rust-play__btn--reset" type="button" hidden>
      초기화
    </button>
    <span class="spacer"></span>
    <span class="rust-play__meta">{channel} / {mode}</span>
    <a
      class="rust-play__link"
      href={playgroundUrl}
      target="_blank"
      rel="noopener noreferrer">Playground에서 열기 ↗</a
    >
  </div>
  <pre class="rust-play__output" aria-live="polite"></pre>
</div>

<script>
  const API = 'https://play.rust-lang.org/execute';

  const q = <T extends Element>(root: Element, sel: string) =>
    root.querySelector(sel) as T;

  function currentCode(root: HTMLElement): string {
    return q<HTMLTextAreaElement>(root, '.rust-play__editor').value;
  }

  function setOutput(root: HTMLElement, nodes: (HTMLElement | string)[]) {
    const out = q<HTMLPreElement>(root, '.rust-play__output');
    out.replaceChildren(...nodes);
    out.classList.add('is-visible');
  }

  function span(cls: string, text: string): HTMLElement {
    const el = document.createElement('span');
    el.className = cls;
    el.textContent = text;
    return el;
  }

  async function run(root: HTMLElement) {
    const btn = q<HTMLButtonElement>(root, '.rust-play__btn--run');
    const editor = q<HTMLTextAreaElement>(root, '.rust-play__editor');
    const editBtn = q<HTMLButtonElement>(root, '.rust-play__btn--edit');
    const resetBtn = q<HTMLButtonElement>(root, '.rust-play__btn--reset');
    // 실행 중에는 편집을 막습니다. 이전 코드의 결과가 새 코드의 출력처럼 보이는 것을 방지합니다
    btn.disabled = true;
    editor.readOnly = true;
    editBtn.disabled = true;
    resetBtn.disabled = true;
    setOutput(root, ['컴파일 및 실행 중… (play.rust-lang.org 사용)']);
    try {
      const res = await fetch(API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          channel: root.dataset.channel,
          mode: root.dataset.mode,
          edition: root.dataset.edition,
          crateType: 'bin',
          tests: false,
          backtrace: false,
          code: currentCode(root),
        }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = (await res.json()) as {
        success: boolean;
        exitDetail?: string;
        stdout: string;
        stderr: string;
      };
      const nodes: (HTMLElement | string)[] = [];
      // 컴파일러 경고와 오류는 stderr에 들어갑니다. Cargo 자체의 진행 표시
      // (Compiling/Finished/Running)만 제거한 뒤 보여 줍니다
      const stderr = data.stderr
        .split('\n')
        .filter(
          (l) =>
            !/^\s*(Compiling playground v|Finished `(dev|release)` profile|Running `target\/)/.test(
              l
            )
        )
        .join('\n')
        .trim();
      if (stderr) nodes.push(span(data.success ? 'stderr' : 'error', stderr));
      if (stderr && data.stdout) nodes.push('\n\n');
      if (data.stdout) nodes.push(data.stdout);
      if (!data.success && data.exitDetail) {
        if (nodes.length > 0) nodes.push('\n\n');
        nodes.push(span('error', data.exitDetail));
      }
      if (nodes.length === 0) nodes.push('(출력 없음)');
      setOutput(root, nodes);
    } catch (err) {
      setOutput(root, [
        span(
          'error',
          `실행 환경에 연결하지 못했습니다: ${err instanceof Error ? err.message : String(err)}`
        ),
      ]);
    } finally {
      btn.disabled = false;
      editor.readOnly = false;
      editBtn.disabled = false;
      resetBtn.disabled = false;
    }
  }

  function enterEdit(root: HTMLElement) {
    root.classList.add('is-editing');
    q<HTMLButtonElement>(root, '.rust-play__btn--edit').hidden = true;
    q<HTMLButtonElement>(root, '.rust-play__btn--reset').hidden = false;
    const editor = q<HTMLTextAreaElement>(root, '.rust-play__editor');
    editor.style.minHeight = `${Math.min(editor.scrollHeight + 8, 480)}px`;
    editor.focus();
  }

  function resetEdit(root: HTMLElement) {
    const editor = q<HTMLTextAreaElement>(root, '.rust-play__editor');
    editor.value = editor.defaultValue;
    root.classList.remove('is-editing');
    q<HTMLButtonElement>(root, '.rust-play__btn--edit').hidden = false;
    q<HTMLButtonElement>(root, '.rust-play__btn--reset').hidden = true;
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const root = target.closest<HTMLElement>('.rust-play');
    if (!root) return;
    if (target.closest('.rust-play__btn--run')) void run(root);
    else if (target.closest('.rust-play__btn--edit')) enterEdit(root);
    else if (target.closest('.rust-play__btn--reset')) resetEdit(root);
  });

  // 편집한 뒤에는 "Playground에서 열기" 링크도 현재 코드 내용을 반영합니다.
  // click의 캡처 단계에서 갱신하면 키보드 조작에서도 이동 전에 링크를 바꿀 수 있습니다
  document.addEventListener(
    'click',
    (e) => {
      const link = (e.target as HTMLElement).closest<HTMLAnchorElement>(
        '.rust-play__link'
      );
      if (!link) return;
      const root = link.closest<HTMLElement>('.rust-play');
      if (!root) return;
      const params = new URLSearchParams({
        version: root.dataset.channel ?? 'stable',
        mode: root.dataset.mode ?? 'debug',
        edition: root.dataset.edition ?? '2024',
        code: currentCode(root),
      });
      link.href = `https://play.rust-lang.org/?${params}`;
    },
    true
  );
</script>
